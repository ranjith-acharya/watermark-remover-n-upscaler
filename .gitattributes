# Normalise to LF in the repository; check out native line endings.
* text=auto

# Shell scripts must stay LF or they will not run on Linux/macOS.
*.sh text eol=lf

# Batch files must stay CRLF or cmd.exe can mis-parse them.
*.bat text eol=crlf

# Never touch binaries.
*.mp4 binary
*.png binary
*.pt  binary
*.pth binary
